{
  "manifest_version": 3,
  "name": "Color Picker Pro",
  "short_name": "ColorPicker",
  "version": "2.0.0",
  "description": "Pick colors from web pages, convert HEX/RGB/HSL, and build custom palettes easily. A sleek offline tool for developers.",
  "homepage_url": "https://github.com/Abinbn",
  "permissions": ["storage", "clipboardWrite", "scripting", "activeTab", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Color Picker Pro",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Open Color Picker Pro"
    },
    "copy-last-color": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Copy last picked color to clipboard"
    },
    "activate-eyedropper": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Activate eyedropper on current page"
    }
  }
}
